#!/bin/bash

#Script of Phage2Pham's pipeline#
#Author: Mireia Bernabeu Gimeno
#Date: 06-09-24

orden="$2"

for f in $orden; do
	echo "$f"
	cat "$1"/"$f".fasta >> "$1"/all_"$3".fasta
	cat "$1"/"$f"_mod2.gff >> "$1"/all_"$3".gff
	cat "$1"/"$f"_all_sorted.o6 >> "$1"/all_"$3".o6
done

awk -F "\t" '{print $1"\t"$2"\t"$3"\t"$4"\t"$5"\t"$13"\t"$7"\t"$11"\t"$9"\t"$10"\t"$11"\t"$12}' "$1"/all_"$3".gff > "$1"/all_"$3"_edited1.gff

awk -F "\t" '{print $1"\t"$2"\t"$3"\t"$4"\t"$5"\t"$13"\t"$7"\t"$12"\t"$9"\t"$10"\t"$11"\t"$12}' "$1"/all_"$3".gff > "$1"/all_"$3"_edited2.gff

/usr/bin/Rscript scripts/gggenomes_fig.R "$1"/all_"$3".fasta "$1"/all_"$3"_edited1.gff "$1"/all_"$3".o6 "$1"/"$3"_fig_phams_"$4"-"$5".svg "$4" "$5"

/usr/bin/Rscript scripts/gggenomes_fig.R "$1"/all_"$3".fasta "$1"/all_"$3"_edited2.gff "$1"/all_"$3".o6 "$1"/"$3"_fig_annot_"$4"-"$5".svg "$4" "$5"

/usr/bin/Rscript scripts/gggenomes_fig2.R "$1"/all_"$3".fasta "$1"/all_"$3"_edited2.gff "$1"/all_"$3".o6 "$1"/"$3"_fig_clean_"$4"-"$5".svg "$4" "$5"

rm "$1"/all_"$3".fasta
rm "$1"/all_"$3".gff
rm "$1"/all_"$3".o6
rm "$1"/all_"$3"_edited1.gff
rm "$1"/all_"$3"_edited2.gff
