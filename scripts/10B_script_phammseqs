#!/bin/bash

#Script of Phage2Pham's pipeline#
#Author: Mireia Bernabeu Gimeno
#Date: 16-07-25

#Join all protein sequences to analyze in the same directory
mkdir "$1"/all_protein_to_analyze
cp "$1"/*.faa "$1"/all_protein_to_analyze

#Execute phammseqs with --pangenome option
phammseqs "$1"/all_protein_to_analyze/* -p -o "$1"/phammseqs_all_protein_to_analyze
